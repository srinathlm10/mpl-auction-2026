# Copy this file to .env.local and fill in the values (all optional).
NEXT_PUBLIC_AUCTION_DATE=2026-11-14
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=

# Live scores (football and volleyball) need a free Supabase project: see README, "Live scores".
# Use the PUBLISHABLE key (it is meant to be public). Never put a secret / service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
