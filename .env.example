# Copy this file to .env.local and fill in the values.
# Leave the two Supabase values EMPTY to run only the public pages on the
# JSON data in src/data (the live auction and admin need Supabase).

# Supabase -> Project Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL=
# The publishable key (sb_publishable_...). Older projects: use NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional site settings
NEXT_PUBLIC_AUCTION_DATE=2026-11-14
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
